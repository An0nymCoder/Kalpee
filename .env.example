# Base de données PostgreSQL
POSTGRES_USER=kalpee
POSTGRES_PASSWORD=kalpee_secret

# Port d'exposition web (Docker Compose)
KALPEE_PORT=8080
KALPEE_FRONTEND_URL=http://localhost:8080

# Secret JWT (minimum 32 caractères)
KALPEE_JWT_SECRET=kalpee-default-super-secret-jwt-key-minimum-256-bits-for-hmac-sha256

# Google OAuth2 (Console Google Cloud > Identifiants > ID client OAuth 2.0)
# URI de redirection autorisées à déclarer dans Google Cloud Console :
# - http://localhost:8080/api/login/oauth2/code/google
# - http://localhost:5173/api/login/oauth2/code/google
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-votre-client-secret
